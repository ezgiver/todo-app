# Backend env vars — copy to .env and adjust as needed.

# PostgreSQL connection string (e.g. from Neon, Supabase, or local Docker).
# Leave commented out (or remove) to fall back to SQLite for local development.
# DATABASE_URL=postgresql://username:password@host:5432/dbname?sslmode=require

# Uncomment below to use SQLite instead:
# DATABASE_URL=sqlite:///todo.db

CORS_ORIGINS=http://localhost:5173
FLASK_APP=wsgi.py
SECRET_KEY=dev-only-not-for-prod
