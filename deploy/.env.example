# deploy/.env.example — copy to .env and fill in real values
# NEVER commit the actual .env file!

# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/todo_db?sslmode=require

# Flask session secret — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_real_secret

# Your domain name (with HTTPS) or the VM's public IP (HTTP-only)
# Examples:
#   DOMAIN=todo.yourdomain.com    (automatic HTTPS via Let's Encrypt)
#   DOMAIN=:80                    (plain HTTP, for IP-only access)
DOMAIN=:80
